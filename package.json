{
  "name": "kimi-webbridge-mcp",
  "version": "1.0.1",
  "type": "module",
  "description": "MCP stdio server exposing the local Kimi WebBridge daemon (127.0.0.1:10086) as MCP tools — usable from DSH, Claude Code, Codex, and any MCP client.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LosEcher/kimi-webbridge-mcp.git"
  },
  "bin": {
    "webbridge-mcp": "server.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/test-client.mjs --mock"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "server.mjs",
    "extras/vivaldi-open.mjs",
    "cordis.patch.yml",
    "dsh-webbridge.cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
